[Unit]
Description=IntelShareAI Backend Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/cyril/IntelShareAI
ExecStart=/home/cyril/IntelShareAI/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
